{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "#assets/*": ["./assets/*"],
      "#components/*": ["./components/*"],
      "#config/*": ["./config/*"],
      "#features/*": ["./features/*"],
      "#constants/*": ["./constants/*"],
      "#data/*": ["./data/*"],
      "#hooks/*": ["./hooks/*"],
      "#json/*": ["./json/*"],
      "#lib/*": ["./lib/*"],
      "#navigation/*": ["./navigation/*"],
      "#notifications/*": ["./notifications/*"],
      "#providers/*": ["./providers/*"],
      "#screens/*": ["./screens/*"],
      "#scripts/*": ["./scripts/*"],
      "#services/*": ["./services/*"],
      "#store/*": ["./store/*"],
      "#types/*": ["./types/*"],
      "#utils/*": ["./utils/*"],
      "#appWrite_config": ["./appWrite_config"],
    }
  }
}
